{
  "name": "dolphin-schedule",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "preview": "vite preview --config ui/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "check": "node scripts/check/verify.mjs",
    "check:source-files": "node scripts/check/check-source-files.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "check:ui": "node scripts/check/ci.mjs",
    "check:pages": "node tests/browser/check-pages.mjs",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/android.ps1",
    "deliver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/deliver.ps1"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.47.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "playwright": "1.55.1",
    "rollup": "4.63.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  }
}
